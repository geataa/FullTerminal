#include <windows.h>
#include "../src/core/Version.h"

1 ICON "app.ico"
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION FT_FILE_VERSION
 PRODUCTVERSION FT_FILE_VERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "FullTerminal"
            VALUE "FileDescription",  "FullTerminal"
            VALUE "FileVersion",      FT_FILE_VERSION_STRING
            VALUE "InternalName",     "FullTerminal"
            VALUE "OriginalFilename", "FullTerminal.exe"
            VALUE "ProductName",      "FullTerminal"
            VALUE "ProductVersion",   FT_FILE_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
