set(FT_NATIVE_ROOT "${CMAKE_SOURCE_DIR}/build/native-installed/x64-ft-static" CACHE PATH "Static client dependency prefix")
if(NOT EXISTS "${FT_NATIVE_ROOT}/lib/pq.lib" OR NOT EXISTS "${FT_NATIVE_ROOT}/lib/mariadbclient.lib" OR NOT EXISTS "${FT_NATIVE_ROOT}/lib/db-lib.lib")
    message(FATAL_ERROR "Run tools/Build-NativeClients.ps1 first. Database client libraries are compiled locally; no database server or system driver is installed.")
endif()
add_library(ft_native_clients INTERFACE)
target_include_directories(ft_native_clients INTERFACE "${FT_NATIVE_ROOT}/include" "${FT_NATIVE_ROOT}/include/mysql")
foreach(lib pq pgcommon pgport mariadbclient db-lib tds replacements tdsutils libssl libcrypto zs)
    target_link_libraries(ft_native_clients INTERFACE "${FT_NATIVE_ROOT}/lib/${lib}.lib")
endforeach()
target_link_libraries(ft_native_clients INTERFACE secur32 bcrypt crypt32 ws2_32 shlwapi)
